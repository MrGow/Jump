/// oGhostBot — Create

// ====================================================
// TEMPORARY VISUAL SETTINGS
// ====================================================

// Rectangle dimensions
bot_width  = 28;
bot_height = 42;

// Placeholder colour
bot_colour = make_color_rgb(140, 155, 165);


// ====================================================
// LIGHT SETTINGS
// ====================================================

// Base light radius
light_radius = 120;

// Enable / disable light
light_enabled = true;

// Softness of the outer edge
light_softness = 24;

// Radius pulse amplitude
light_pulse_amount = 5;

// Pulse duration in frames
// 120 frames = 2 seconds at 60 FPS
light_pulse_duration = 120;

// Current pulse position
light_pulse_timer = 0;

// Current visual radius
light_visual_radius = light_radius;