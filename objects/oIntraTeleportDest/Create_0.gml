/// oIntraTeleportDest — Create

// Match this with the trigger's target_id
teleport_id = "";

// Optional facing after teleport
//  1 = face right
// -1 = face left
//  0 = keep current facing
facing = 0;

// Usually invisible
visible = false;

// Small optional spawn offset
spawn_xoff = 0;
spawn_yoff = 0;